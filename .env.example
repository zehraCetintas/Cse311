# Copy this file to .env and change the values. .env is ignored by git.
# Everything is optional for local development: without a .env file the
# project runs with DEBUG on and a development-only secret key.

# Turn off on any server that other people can reach.
DJANGO_DEBUG=true

# Required when DJANGO_DEBUG=false. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Comma-separated host names the site is served from (needed when DEBUG is off),
# e.g. example.com,www.example.com
DJANGO_ALLOWED_HOSTS=

# Comma-separated origins for HTTPS forms behind a domain, e.g. https://example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
